<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>              <string>Tapproof</string>
    <key>CFBundleExecutable</key>        <string>tapproof</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Kosuke Satake. MIT License.</string>
    <key>CFBundleIdentifier</key>        <string>dev.kosuke.Tapdeck.tapproof</string>
    <key>CFBundlePackageType</key>       <string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key>           <string>1</string>
    <key>LSMinimumSystemVersion</key>    <string>15.0</string>
    <key>LSUIElement</key>               <true/>
    <!-- Required for Core Audio process taps (per-app audio capture).
         Without this key TCC returns no error, only silence. -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>Tapdeck captures audio from individual apps so it can mix them.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Tapdeck reads the input side of its virtual devices to verify them.</string>
</dict>
</plist>
