            "state": "translated",
            "value": "%@ 已添加为输出"
          }
        }
      }
    },
    "%@ is both a source and an output of this mix, which would feed back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is both a source and an output of this mix, which would feed back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がこのミックスのソースと出力の両方になっていて，フィードバックしてしまいます．"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 同时是此混音的音源和输出，会形成反馈回路。"
          }
        }
      }
    },
    "%@ is not available — turn the receiver on, or choose it in Control Center › Sound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not available — turn the receiver on, or choose it in Control Center › Sound"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は利用できません — レシーバーの電源を入れるか，コントロールセンター › サウンドで選んでください．"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不可用 — 请打开接收器，或在“控制中心 › 声音”中选择它"
          }
        }
      }
    },
