    "Delay the faster outputs until the echo between them disappears.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay the faster outputs until the echo between them disappears."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反響が消えるまで，速い出力を遅らせてください．"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为较快的输出添加延时，直到它们之间的回声消失。"
          }
        }
      }
    },
    "Delay the faster outputs until the echo between them disappears. This device reports %@ ms of its own; wireless devices often report less than they add.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay the faster outputs until the echo between them disappears. This device reports %@ ms of its own; wireless devices often report less than they add."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反響が消えるまで，速い出力を遅らせてください．このデバイスは %@ ms と報告していますが，ワイヤレス機器は実際より小さい値を報告することがよくあります．"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为较快的输出添加延时，直到它们之间的回声消失。此设备报告的自身延迟为 %@ ms；无线设备报告的值通常小于其实际增加的延迟。"
          }
        }
      }
    },
    "Delay the other speakers by the typical difference. Fine-tune each by ear afterwards.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay the other speakers by the typical difference. Fine-tune each by ear afterwards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般的な差の分だけ，ほかのスピーカーを遅らせます．あとで耳を頼りに1つずつ微調整してください．"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按典型差值为其他扬声器添加延时。之后再凭听感逐个微调。"
          }
        }
      }
    },
    "Delay this output to line it up with a slower one": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay this output to line it up with a slower one"
