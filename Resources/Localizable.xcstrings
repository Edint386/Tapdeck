    "What it plays, after its effects and volume. A stopped mix is started for you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it plays, after its effects and volume. A stopped mix is started for you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エフェクトと音量を通したあとの，ミックスの音を録音します．停止中のミックスは自動で開始します．"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制所选混音经过效果和音量处理后的声音。已停止的混音会自动开始运行。"
          }
        }
      }
    },
