    "Each source and extra output holds this much audio before it plays. Larger buffers add delay but ride out clock drift and busy moments without dropouts. Applies to mixes started after the change.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each source and extra output holds this much audio before it plays. Larger buffers add delay but ride out clock drift and busy moments without dropouts. Applies to mixes started after the change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ソースと追加の出力は，再生の前にこの量の音をためます．バッファが大きいほど遅延は増えますが，クロックのずれや負荷の高い場面でも音切れしにくくなります．変更後に開始したミックスから適用されます．"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个音源和额外输出在播放前都会缓存这么多音频。缓冲区越大，延迟越高，但能在时钟漂移和系统繁忙时避免断音。更改后开始的混音才会应用此设置。"
          }
        }
      }
    },
    "Effects": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effects"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エフェクト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "效果"
          }
        }
      }
    },
