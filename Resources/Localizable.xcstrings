    "Running — %lld of %lld source(s), %lld of %lld output(s). AirPlay is not available: turn the receiver on, or choose it once in Control Center › Sound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running — %lld of %lld source(s), %lld of %lld output(s). AirPlay is not available: turn the receiver on, or choose it once in Control Center › Sound"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中 — ソース %1$lld/%2$lld 件，出力 %3$lld/%4$lld 件が接続済み．AirPlay を利用できません：レシーバーの電源を入れるか，コントロールセンター › サウンドで一度選んでください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行中 — 音源 %lld/%lld，输出 %lld/%lld。AirPlay 不可用：请打开接收器，或在“控制中心 › 声音”中选择一次该接收器"
          }
        }
      }
    },
    "Running — %lld of %lld source(s), %lld of %lld output(s). AirPlay is the Mac's output while this mix runs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running — %lld of %lld source(s), %lld of %lld output(s). AirPlay is the Mac's output while this mix runs"
