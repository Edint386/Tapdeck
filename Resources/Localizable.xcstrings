        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中 — ソース %1$lld/%2$lld 件，出力 %3$lld/%4$lld 件が接続済み．このミックスの実行中は AirPlay が Mac の出力になります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行中 — 音源 %lld/%lld，输出 %lld/%lld。此混音运行期间，AirPlay 将作为 Mac 的输出"
          }
        }
      }
    },
