    },
    "While this mix runs, AirPlay becomes the Mac's output and apps are heard only through the mix. The receiver is chosen in Control Center › Sound.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this mix runs, AirPlay becomes the Mac's output and apps are heard only through the mix. The receiver is chosen in Control Center › Sound."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このミックスの実行中は，AirPlay が Mac の出力になり，アプリの音はミックスを通してのみ聞こえます．レシーバーは，コントロールセンター › サウンドで選びます．"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此混音运行时，AirPlay 会成为 Mac 的输出，App 的声音只能通过混音听到。接收器需在“控制中心 › 声音”中选择。"
          }
        }
      }
